{
"hosting": {
  "public": ".",
    "ignore": [
     "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
        {
          "source": "**",
          "headers": [
            {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revaldate"
          } 
        ] 
      }
    ]
  "cleanUrls": true,
  "trailingSlash": false
  }
}

        
            
          
        
      
      
      "cleanUrls":true,
      "trailingSlash": false
      "rewrites": [
      {
      "source": "**",
        "destination": "/index.html"
    ]
  }
}
